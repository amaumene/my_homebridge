{
  "pluginAlias": "AirCloudHome",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "AirCloudHome",
        "required": true
      },
      "email": {
        "title": "Email",
        "type": "string",
        "format": "email",
        "required": true
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "x-schema-form": {
          "type": "password"
        }
      },
      "pollInterval": {
        "title": "Poll Interval (seconds)",
        "type": "integer",
        "default": 120,
        "minimum": 60
      },
      "showDryMode": {
        "title": "Show Dry mode switch",
        "type": "boolean",
        "default": true,
        "description": "Uncheck to hide the Dry (dehumidify) switch."
      },
      "showAutoFan": {
        "title": "Show Auto Fan switch",
        "type": "boolean",
        "default": true,
        "description": "Uncheck to hide the Auto Fan switch."
      },
      "showSwingVertical": {
        "title": "Show Swing Vertical switch",
        "type": "boolean",
        "default": true,
        "description": "Uncheck to hide the Swing Vertical (louver swing) switch."
      }
    }
  }
}
